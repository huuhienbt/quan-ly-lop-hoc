# Sao chép sang web/.env.local cho phát triển; Vercel dùng .env.production.example.
# Không đưa các giá trị bí mật vào Git hoặc gửi qua chat.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
D1_GATEWAY_URL=
D1_GATEWAY_TOKEN=
# Chỉ dành cho phát triển local; setup:local tự cấu hình hai biến này.
D1_LOCAL_API_URL=
D1_LOCAL_API_TOKEN=
# Email Google đã được xác minh; nhiều email ngăn bằng dấu phẩy.
SUPER_ADMIN_EMAILS=huuhienbte@gmail.com
